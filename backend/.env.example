APP_NAME=Screen Recorder Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]
GOOGLE_API_KEY=
TRANSLATION_API_VERSION=v1
TRANSLATION_MODEL=gemini-flash-latest
LIVE_CAPTION_MODEL=gemini-2.0-flash-lite
LIVE_CAPTION_MIN_INTERVAL_SECONDS=1
LIVE_CAPTION_CACHE_TTL_SECONDS=20
LIVE_CAPTION_MIN_AUDIO_BYTES=2500
TRANSLATION_QUOTA_COOLDOWN_SECONDS=60
TRANSCRIPTION_CHUNK_SECONDS=45
MAX_TRANSCRIPTION_SECONDS=900
LIVE_CAPTION_CHUNK_SECONDS=3
LIVE_CAPTION_BACKEND=whisper-local
CAPTIONS_BACKEND=whisper-local
WHISPER_MODEL_SIZE=base
LIVE_WHISPER_MODEL_SIZE=tiny
CAPTIONS_WHISPER_MODEL_SIZE=base
GOOGLE_TRANSLATE_PROJECT_ID=
LOCAL_TRANSLATION_PROVIDER=nllb
LOCAL_TRANSLATION_MODEL=facebook/nllb-200-distilled-600M

# Live caption backend chain (ordered: primary first, then fallbacks).
# Entries: 'meta', 'whisper-google', 'whisper-local', 'gemini'.
# Model/engine selection is server-side only; clients cannot choose backends.
# Empty value falls back to the single LIVE_CAPTION_BACKEND above.
LIVE_CAPTION_BACKENDS=meta,whisper-local

# Meta Model API (https://dev.meta.ai). Required for the 'meta' backend
# and the 'spark' translation leg. Your Meta credits are billed here.
META_MODEL_API_KEY=
META_ASR_MODEL=muse-voice-transcribe-1.0
# Turn mode: PUSH_TO_TALK, ENDPOINTING (recommended for captions), DIARIZATION
META_ASR_MODE=ENDPOINTING
META_SPARK_MODEL=muse-spark-1.3
# Translation leg for Meta backends: 'nllb' (local, free) or 'spark' (Meta API).
META_TRANSLATION_ENGINE=nllb
STREAM_TRANSLATION_FALLBACKS=spark

# Realtime live-stream transport (frontend PCM -> backend WS -> Meta).
LIVE_STREAM_ENABLED=true
LIVE_STREAM_PARTIAL_DEBOUNCE_MS=600
LIVE_STREAM_FRAME_MS=80
LIVE_STREAM_OP_TIMEOUT_SECONDS=10
