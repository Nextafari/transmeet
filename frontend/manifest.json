{
  "manifest_version": 3,
  "name": "Meet Recorder (Dev)",
  "description": "Lightweight browser screen recorder",
  "version": "0.1.0",

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "offscreen",
    "storage",
    "downloads",
    "tabCapture",
    "desktopCapture",
    "activeTab",
    "scripting",
    "identity"
  ],
  "oauth2": {
    "client_id": "587174205968-85am7hf9f0mighk8r6licr797s78rmdc.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "host_permissions": [
    "<all_urls>",
    "https://www.googleapis.com/*"
  ]
}
